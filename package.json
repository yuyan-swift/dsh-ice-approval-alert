{
  "name": "dsh-ice-approval-alert",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "右侧栏插件：审批出现时播放“冰冰冰”音效，并在 5 / 10 / 15 分钟再次提醒，15 分钟后自动停止。",
  "keywords": ["dsh", "dsh-plugin", "approval", "ice", "sound", "sidebar"],
  "icon": "./icon.svg",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "icon.svg", "README.md", "LICENSE", "CHANGELOG.md", "SECURITY.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js"
  },
  "author": "yuyan-swift",
  "repository": {
    "type": "git",
    "url": "https://github.com/yuyan-swift/dsh-ice-approval-alert.git"
  },
  "homepage": "https://github.com/yuyan-swift/dsh-ice-approval-alert#readme",
  "bugs": {
    "url": "https://github.com/yuyan-swift/dsh-ice-approval-alert/issues"
  },
  "license": "MIT"
}
